REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~edwinal.bmp~ @90 /* no edwina file found exiting */

// return to edwin
COPY_EXISTING ~spin662.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 107 target = 2 parameter2 = 1 timing = 1 STR_VAR resource = nedwinm END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 107 target = 2 parameter2 = 0 timing = 1 STR_VAR resource = nedwins END
// edwina
COPY_EXISTING ~spin916.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 107 target = 2 parameter2 = 1 timing = 1 STR_VAR resource = edwinal END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 107 target = 2 parameter2 = 0 timing = 1 STR_VAR resource = edwinam END
